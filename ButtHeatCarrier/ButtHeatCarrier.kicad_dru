(version 1)

# Intentional courtyard overlaps (parts themselves have physical clearance or are build variants).
# Dual button footprints: THT + SMD switch overlaid on the same nets, only one is fitted.
(rule "Dual button footprints"
	(condition "(A.Reference == 'SW1' && B.Reference == 'SW2') || (A.Reference == 'SW3' && B.Reference == 'SW4')")
	(constraint courtyard_clearance (min -10mm))
	(severity ignore))

# Courtyard-only touches with physical clearance between the parts.
# U4/C3: buck input cap hugs U4 on purpose (small input loop); ~0.8 mm pad-to-pad.
# JP1/U3: JP1 is a flat solder jumper, no body; ~0.65 mm from U3 pin 4.
(rule "Accepted courtyard touches"
	(condition "(A.Reference == 'SW3' && B.Reference == 'H2') || (A.Reference == 'SW1' && B.Reference == 'H1') || (A.Reference == 'J2' && B.Reference == 'ENC3') || (A.Reference == 'ENC1' && B.Reference == 'D1') || (A.Reference == 'U4' && B.Reference == 'C3') || (A.Reference == 'JP1' && B.Reference == 'U3')")
	(constraint courtyard_clearance (min -10mm))
	(severity ignore))

# Display-neck crossing at the flex slot: everything from left (MCU) to right (buck, encoders,
# USB) squeezes past the slot. Inside the rule area named NECK (drawn in pcbnew, no constraints of
# its own): signal tracks 0.2 mm, power tracks 0.4 mm, 0.15 mm clearance.
(rule "Neck: signal tracks"
	(condition "A.intersectsArea('NECK') && A.NetClass == 'Default'")
	(constraint track_width (min 0.15mm) (opt 0.2mm)))

(rule "Neck: power tracks"
	(condition "A.intersectsArea('NECK') && A.NetClass == 'Power'")
	(constraint track_width (min 0.3mm) (opt 0.4mm)))

(rule "Neck: clearance"
	(condition "A.intersectsArea('NECK') || B.intersectsArea('NECK')")
	(constraint clearance (min 0.15mm)))

# XKB U262-16XN (J2) stock land pattern: corner GND pads sit 0.165 mm from the locating-peg drills.
(rule "J2 XKB peg to pad"
	(condition "A.Parent == 'J2' && B.Parent == 'J2'")
	(constraint hole_clearance (min 0.15mm)))
